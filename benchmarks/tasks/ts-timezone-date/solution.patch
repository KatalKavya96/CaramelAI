--- a/test/dates.test.ts
+++ b/test/dates.test.ts
@@ -7,6 +7,14 @@ test("formats a due date", () => {
   expect(formatDueDate("2024-12-31")).toBe("Tue 31 Dec");
 });
 
+test("a calendar date does not move with the machine's time zone", () => {
+  // Runs the check in a child process so TZ applies from the start.
+  const run = Bun.spawnSync(["bun", "-e", 'import { formatDueDate } from "./src/dates"; console.log(formatDueDate("2025-03-03"))'], {
+    env: { ...process.env, TZ: "America/Los_Angeles" },
+  });
+  expect(run.stdout.toString().trim()).toBe("Mon 3 Mar");
+});
+
