diff --git a/src/dates.ts b/src/dates.ts
index 9be30bc..f90a064 100644
--- a/src/dates.ts
+++ b/src/dates.ts
@@ -3,6 +3,8 @@ const MONTHS = ["Jan", "Feb", "Mar", "Apr", "May", "Jun", "Jul", "Aug", "Sep", "
 
 /** "2025-03-03" -> "Mon 3 Mar". The input is a calendar date with no time of day. */
 export function formatDueDate(isoDate: string): string {
+  // new Date("YYYY-MM-DD") is midnight UTC. Read it back in UTC too: local getters would show
+  // the previous day anywhere west of Greenwich.
   const date = new Date(isoDate);
-  return `${DAYS[date.getDay()]} ${date.getDate()} ${MONTHS[date.getMonth()]}`;
+  return `${DAYS[date.getUTCDay()]} ${date.getUTCDate()} ${MONTHS[date.getUTCMonth()]}`;
 }
diff --git a/test/dates.test.ts b/test/dates.test.ts
