diff --git a/README.md b/README.md
index 6f53bdf..a61405d 100644
--- a/README.md
+++ b/README.md
@@ -14,16 +14,16 @@ import { slugify } from "tidy-slug";
 slugify("Hello, World!");
 // => "hello-world"
 
-slugify("Crème Brûlée Recipe", { sep: "_" });
+slugify("Crème Brûlée Recipe", { separator: "_" });
 // => "creme_brulee_recipe"
 
 slugify("A very long blog post title about slugs", { maxLength: 20 });
-// => "a-very-long-blog-pos"
+// => "a-very-long-blog"
 ```
 
 ## Options
 
 | Option      | Default | Meaning                                  |
 |-------------|---------|------------------------------------------|
-| `sep`       | `"-"`   | Put between words.                       |
-| `maxLength` | none    | Longest slug allowed, in characters.     |
+| `separator` | `"-"`   | Put between words.                       |
+| `maxLength` | none    | Longest slug allowed, in characters. Cut after the last whole word that fits. |
