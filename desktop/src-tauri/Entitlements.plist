<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Notarization requires the hardened runtime, which forbids writable-and-executable memory. The
  backend sidecar is a `bun build --compile` binary: JavaScriptCore compiles JavaScript to machine
  code at run time (JIT), so without these two entitlements it is killed the moment it starts.
  Tauri signs the sidecar with this same file. Not sandboxed (no com.apple.security.app-sandbox):
  the backend starts sandbox-exec for each command, and Seatbelt cannot be nested inside App Sandbox.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
