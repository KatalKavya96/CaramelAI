{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Caramel",
  "version": "0.1.0",
  "identifier": "dev.caramel.desktop",
  "build": {},
  "app": {
    "windows": [],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"],
    "externalBin": ["binaries/caramel-backend"],
    "resources": { "../../web/dist/": "web-dist/" },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "./Entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_THE_PUBLIC_KEY_FROM_tauri_signer_generate",
      "endpoints": ["https://github.com/KatalKavya96/CaramelAI/releases/latest/download/latest.json"]
    }
  }
}
